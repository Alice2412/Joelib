/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"account_id": "51a849fd51f1774937bb4155db033c92",
	"name": "chatjoept",
	"compatibility_date": "2026-11-04",
	"main": "./workers/app.ts",
	"vars": {
		"ALLOWED_EMAIL_DOMAINS": "united-taylors.org,sstx.org,hamdenhall.org",
		"RESEND_FROM_EMAIL": "ChatJoePT <chatjoept-noreply@united-taylors.org>",
		"LLM_API_URL": "https://api.deepseek.com",
		"LLM_BASE_MODEL": "deepseek-chat"
	},
	"kv_namespaces": [
		{
			"binding": "CHATJOEPT_KV",
			"id": "d87c99907ebc4fc0b58e538e62fd6c1d"
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
